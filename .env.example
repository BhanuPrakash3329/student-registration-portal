# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=

# Neon / PostgreSQL connection string. Copy from Neon Console; require SSL in production.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Admin is created on first run if this email does not already exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Configure an SMTP provider for real password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
