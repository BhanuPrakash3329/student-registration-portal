# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=

# MySQL 8+ connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=student_portal
DB_PASSWORD=
DB_NAME=student_portal
DB_SSL=false
# Optional: base64-encoded provider CA PEM when TLS is required.
DB_SSL_CA=

# Admin is created on first run if this email does not already exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Configure an SMTP provider for real password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
